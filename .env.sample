# Copy this file to .env and fill in real secret values.

# Database connection for Prisma (Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT secret used to sign tokens — use a long, random string
JWT_SECRET=replace_with_a_secure_random_string

# Backend URL for constructing links (e.g., in emails)
BACKEND_URL=http://localhost:5000
